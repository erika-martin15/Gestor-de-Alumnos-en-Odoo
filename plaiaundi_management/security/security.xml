<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_plaiaundi" model="ir.module.category">
            <field name="name">Gestion de Plaiaundi</field>
            <field name="description">Categoria para la gestion de Plaiaundi</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_plaiaundi_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="plaiaundi_management.module_category_plaiaundi"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_plaiaundi_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="plaiaundi_management.module_category_plaiaundi"/>
            <field name="implied_ids" eval="[(4, ref('plaiaundi_management.group_plaiaundi_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
