<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aula_form" model="ir.ui.view">
        <field name="name">plaiaundi.aula.form</field>
        <field name="model">plaiaundi.aula</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="ciclo_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos Instalados">
                            <field name="equipment_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aula_tree" model="ir.ui.view">
        <field name="name">plaiaundi.aula.tree</field>
        <field name="model">plaiaundi.aula</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="ciclo_id"/>
            </tree>
        </field>
    </record>

    <record id="action_aula" model="ir.actions.act_window">
        <field name="name">Aulas</field>
        <field name="res_model">plaiaundi.aula</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>