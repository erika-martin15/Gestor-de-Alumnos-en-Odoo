<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ciclo_form" model="ir.ui.view">
        <field name="name">plaiaundi.ciclo.form</field>
        <field name="model">plaiaundi.ciclo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: DAW3"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="level"/>
                    </group>
                    <notebook>
                        <page string="Alumnos">
                            <field name="students_ids"/>
                        </page>
                        <page string="Profesores">
                            <field name="teachers_ids"/>
                        </page>
                        <page string="Aulas">
                            <field name="classrooms_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ciclo_tree" model="ir.ui.view">
        <field name="name">plaiaundi.ciclo.tree</field>
        <field name="model">plaiaundi.ciclo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="level"/>
            </tree>
        </field>
    </record>

    <record id="action_ciclo" model="ir.actions.act_window">
        <field name="name">Ciclos Formativos</field>
        <field name="res_model">plaiaundi.ciclo</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>