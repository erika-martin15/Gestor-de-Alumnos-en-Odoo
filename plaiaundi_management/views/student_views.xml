<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_alumno_form" model="ir.ui.view">
        <field name="name">plaiaundi.alumno.form</field>
        <field name="model">plaiaundi.alumno</field>
        <field name="arch" type="xml">
            <form string="Ficha del Alumno">
                <header>
                    <button name="action_mark_active" 
                            string="Reactivar" 
                            type="object" 
                            class="oe_highlight" 
                            invisible="active"/>

                    <button name="action_mark_inactive" 
                            string="Archivar" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="not active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre Completo"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_code"/>
                            <field name="email"/>
                            <field name="ciclo_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipamiento">
                            <group>
                                <field name="assigned_computer"/>
                                <field name="assigned_monitor"/>
                            </group>
                        </page>
                        <page string="Académico">
                            <field name="grades_ids"/>
                        </page>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_alumno_tree" model="ir.ui.view">
        <field name="name">plaiaundi.alumno.tree</field>
        <field name="model">plaiaundi.alumno</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="student_code"/>
                <field name="name"/>
                <field name="ciclo_id"/>
                <field name="email"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_alumno_search" model="ir.ui.view">
        <field name="name">plaiaundi.alumno.search</field>
        <field name="model">plaiaundi.alumno</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_code"/>
                <field name="ciclo_id"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Ciclo Formativo" name="group_by_cycle" context="{'group_by': 'ciclo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_alumno" model="ir.actions.act_window">
        <field name="name">Estudiantes</field>
        <field name="res_model">plaiaundi.alumno</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear el primer estudiante
          </p>
        </field>
    </record>

</odoo>