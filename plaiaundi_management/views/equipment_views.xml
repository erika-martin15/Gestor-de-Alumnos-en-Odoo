<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipo_form" model="ir.ui.view">
        <field name="name">plaiaundi.equipo.form</field>
        <field name="model">plaiaundi.equipo</field>
        <field name="arch" type="xml">
            <form string="Equipamiento">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Ej: PC-AULA1-01"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_type"/>
                            <field name="serial_number"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="aula_id"/>
                            <field name="assigned_student" invisible="equipment_type == 'other'"/>
                            <field name="purchase_date"/>
                            <field name="purchase_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Incidencias">
                            <field name="incident_ids"/>
                        </page>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipo_tree" model="ir.ui.view">
        <field name="name">plaiaundi.equipo.tree</field>
        <field name="model">plaiaundi.equipo</field>
        <field name="arch" type="xml">
            <tree decoration-danger="status == 'broken'" decoration-warning="status == 'maintenance'">
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="serial_number"/>
                <field name="aula_id"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'working'" 
                       decoration-info="status == 'new'"/>
            </tree>
        </field>
    </record>

    <record id="view_equipo_search" model="ir.ui.view">
        <field name="name">plaiaundi.equipo.search</field>
        <field name="model">plaiaundi.equipo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="aula_id"/>
                <filter string="Averiado" name="broken" domain="[('status', '=', 'broken')]"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Tipo" name="group_by_type" context="{'group_by': 'equipment_type'}"/>
                    <filter string="Aula" name="group_by_classroom" context="{'group_by': 'aula_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_equipo" model="ir.actions.act_window">
        <field name="name">Equipamiento</field>
        <field name="res_model">plaiaundi.equipo</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>